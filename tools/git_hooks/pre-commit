#!/bin/sh
# Refuse a commit that carries a model weight, and refuse a commit that
# leaves the manifest stale.
#
# The competition forbids shipping model weights, and this repository is
# the one the reviewers read.  The .gitignore already excludes the known
# weight locations, but .gitignore is a *convention*: it protects the
# files it knows about and nothing else.  A file that arrives under a new
# name, in a new directory, or that was added with `git add -f` would
# slip past it.
#
# So the rule is enforced on the staged set, at the moment of the
# commit.  A weight in the index is a hard failure with a clear message
# rather than a 200 MiB blob in the repository's history, where it would
# stay forever.
#
# The check looks at the files that are actually staged, and it looks at
# their *names*.  A file called `checkpoint.npz` is refused whatever it
# contains; a file called `model.py` is allowed whatever it contains.
#
# The staged names are read through a temporary file rather than through
# a command substitution, because a command substitution drops NUL bytes
# and a file name with a CJK character would then be mangled.
#
# The second rule is about MANIFEST.json.  It is the inventory of what
# the repository ships, and it is generated from the tree, so it drifts
# the moment a file changes.  A stale manifest fails the CI check
# "Verify the manifest describes this checkout" on every push, and the
# failure names a file the developer did not touch.  So the hook
# regenerates the manifest, and refuses the commit when the regenerated
# manifest differs from the committed one - with the one-line remedy.
#
# This file lives in the repository (rather than only in .git/hooks) so
# that it travels: ``tools/install_git_hooks.py`` copies it into a fresh
# clone's hooks directory.

set -e

# The weight-like suffixes.  Same list the packager and the repository
# verifier use, so the three of them agree.
SUFFIXES="npz npy pkl pickle bin pt pth joblib onnx safetensors h5 hdf5 ckpt model gguf mlmodel pt2 pth2 weights"

LIST=$(mktemp 2>/dev/null || echo "./.git/pre-commit-staged.$$")
trap 'rm -f "$LIST"' EXIT INT TERM

# ``-z`` so that a name with a space or a CJK character survives.
git diff --cached --name-only --diff-filter=ACMR -z > "$LIST"

FOUND=$(python - "$LIST" "$SUFFIXES" <<'PYTHON' 2>/dev/null || true
import sys

path, suffixes = sys.argv[1], sys.argv[2].split()
suffixes = tuple("." + s for s in suffixes)
try:
    with open(path, "rb") as stream:
        names = stream.read().split(b"\0")
except OSError:
    raise SystemExit(0)

for raw in names:
    if not raw:
        continue
    name = raw.decode("utf-8", "replace").rsplit("/", 1)[-1].lower()
    if name.endswith(suffixes):
        sys.stdout.write(raw.decode("utf-8", "replace") + "\n")
PYTHON
)

if [ -z "$FOUND" ]; then
    # Python is not always on the PATH (a bare checkout may only have the
    # Windows launcher), so fall back to a POSIX-shell scan.  The names
    # are read line by line, which is wrong for a name containing a
    # newline and right for everything else.
    FOUND=$(tr '\0' '\n' < "$LIST" | while IFS= read -r path; do
        [ -z "$path" ] && continue
        base=$(basename "$path" | tr 'A-Z' 'a-z')
        for suffix in $SUFFIXES; do
            case "$base" in
                *."$suffix") printf '%s\n' "$path"; break ;;
            esac
        done
    done)
fi

if [ -n "$FOUND" ]; then
    echo "REFUSED: a model weight is staged.  The competition forbids" >&2
    echo "shipping weights, and a blob in the history cannot be removed" >&2
    echo "without rewriting it.  Unstage the file(s):" >&2
    printf '  git rm --cached "%s"\n' $FOUND >&2
    echo >&2
    echo "The weights are regenerated by the training code at evaluation time." >&2
    exit 1
fi

# ---- the manifest must agree with the tree ------------------------------
#
# MANIFEST.json is generated from the tree, so it drifts as soon as a
# file changes.  The CI job "Verify the manifest describes this
# checkout" then fails on every push, and it names a file the developer
# never touched, which is a bad way to lose an afternoon.
#
# The check regenerates the manifest into a temporary file and compares
# it with the committed one.  A difference means the committed manifest
# is stale; the remedy is one command.

if [ -f MANIFEST.json ] && [ -f tools/refresh_manifest.py ]; then
    FRESH=$(mktemp 2>/dev/null || echo "./.git/pre-commit-manifest.$$")
    trap 'rm -f "$LIST" "$FRESH"' EXIT INT TERM

    if python tools/refresh_manifest.py --out "$FRESH" >/dev/null 2>&1; then
        if ! cmp -s "$FRESH" MANIFEST.json; then
            echo "REFUSED: MANIFEST.json is stale." >&2
            echo >&2
            echo "It is the inventory of what this repository ships, and" >&2
            echo "the tree has moved on since it was generated.  The CI job" >&2
            echo "\"Verify the manifest describes this checkout\" fails on a" >&2
            echo "stale manifest, and it names a file you did not touch." >&2
            echo >&2
            echo "Regenerate it and stage the result:" >&2
            echo "  python tools/refresh_manifest.py && git add MANIFEST.json" >&2
            exit 1
        fi
    fi
    rm -f "$FRESH"
fi

exit 0
